---
import arrowRightIcon from '#/assets/icons/icon-arrow-right.svg';
import figmaPlugin from '#/assets/figma-plugin.jpg';
import slide2 from '#/assets/slides/slide2.jpg';
import slide3 from '#/assets/slides/slide3.jpg';
import slide4 from '#/assets/slides/slide4.jpg';
import slide5 from '#/assets/slides/slide5.jpg';
import slide1 from '#/assets/slides/slide1.jpg';
import Footer from '#/components/Footer/Footer.astro';
import Header from '#/components/Header/Header.astro';
import Layout from '#/layouts/Layout.astro';
import styles from '#/pages/plugin/plugin.module.scss';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const pluginSections = [
    {
        image: slide2,
        title: 'Check and export from the source',
        description:
            'Use the Token tab to review architecture and export local Variables and Styles. Use the Design tab to audit text contrast and token usage without changing the Figma file.',
        alt: 'Design Token Kit plugin export panel with token architecture checks and format choices.',
    },
    {
        image: slide3,
        title: 'Export structured DTCG tokens',
        description:
            'Create portable token files with paths, types, values, and compatible local aliases. Variable modes are written as separate theme files.',
        alt: 'Figma token layers mapped to a structured DTCG JSON output.',
    },
    {
        image: slide4,
        title: 'Generate code for the web',
        description:
            'Convert the DTCG export into CSS custom properties, SCSS variables, or a Tailwind CSS v4 theme from the same token source.',
        alt: 'CSS, SCSS, and Tailwind CSS outputs generated from one shared token system.',
    },
    {
        image: slide5,
        title: 'Generate SwiftUI code',
        description:
            'Generate a readable DesignTokens.swift file from the exported token set, including the values your SwiftUI views consume.',
        alt: 'Readable SwiftUI code generated from the Figma token system.',
    },
    {
        image: slide1,
        title: 'Bring tokens into product code',
        description:
            'Start with DTCG and theme files from Figma, then use the CLI or Core API when the same token contract needs to move through your build.',
        action: 'Install from Figma Community',
        alt: 'Connected flow from Figma Variables and Styles through DTCG tokens to production code.',
    },
];
---

<Layout
    title="Figma Plugin | Design Token Kit"
    description="Export, audit, and convert Figma Variables and Styles for production-ready design token workflows."
>
    <Header />

    <main class={styles.page}>
        <section class={styles.hero} aria-labelledby="plugin-title">
            <div class={styles.heroContent}>
                <p class={styles.eyebrow}>Figma plugin</p>
                <h1 id="plugin-title">From Figma variables to code-ready tokens.</h1>
                <p class={styles.lead}>
                    Export local Variables and Styles to DTCG, review token architecture and design findings, then
                    generate platform output from the same token source.
                </p>
                <div class={styles.actions}>
                    <a
                        class={`${styles.primaryAction} ${styles.action}`}
                        href="https://www.figma.com/community/plugin/1661669063434861129/design-token-kit"
                        target="_blank"
                        rel="noreferrer"
                    >
                        <span>Install from Figma Community</span>
                        <img src={arrowRightIcon.src} width="20" height="20" alt="" />
                    </a>
                    <a class={`${styles.secondaryAction} ${styles.action}`} href={`${baseUrl}docs/figma-plugin/overview/`}>
                        <span>Read the plugin guide</span>
                        <img src={arrowRightIcon.src} width="20" height="20" alt="" />
                    </a>
                </div>
            </div>

            <div class={styles.heroVisual}>
                <img
                    src={figmaPlugin.src}
                    width={figmaPlugin.width}
                    height={figmaPlugin.height}
                    alt="Design Token Kit Figma plugin workflow from Variables and Styles to production-ready token output."
                />
            </div>
        </section>

        <section class={styles.showcase} aria-labelledby="showcase-title">
            <div class={styles.showcaseHeader}>
                <div>
                    <p class={styles.eyebrow}>Plugin workflow</p>
                    <h2 id="showcase-title">One token workflow, from Figma to product.</h2>
                </div>
                <p>Start with the design file, make the token structure visible, and generate the files each platform needs.</p>
            </div>

            <div class={styles.showcaseList}>
                {pluginSections.map((section, index) => (
                    <article class={styles.showcaseItem}>
                        <div class={styles.showcaseMedia}>
                            <img
                                src={section.image.src}
                                width={section.image.width}
                                height={section.image.height}
                                alt={section.alt}
                                loading={index === 0 ? 'eager' : 'lazy'}
                            />
                        </div>
                        <div class={styles.showcaseCopy}>
                            <h3>{section.title}</h3>
                            <p>{section.description}</p>
                            {section.action && (
                                <a
                                    class={`${styles.primaryAction} ${styles.action}`}
                                    href="https://www.figma.com/community/plugin/1661669063434861129/design-token-kit"
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    <span>{section.action}</span>
                                    <img src={arrowRightIcon.src} width="20" height="20" alt="" />
                                </a>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>

    <Footer />
</Layout>
