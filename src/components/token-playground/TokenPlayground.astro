---
import styles from '#/components/token-playground/TokenPlayground.module.scss';
import { playgroundExamples } from '#/components/token-playground/examples';

interface Props {
    full?: boolean;
}

const { full = false } = Astro.props;

interface Option {
    value: string;
    label: string;
}

const inputFormats: Option[] = [
    { value: 'auto', label: 'Auto-detect' },
    { value: 'dtcg', label: 'DTCG JSON' },
    { value: 'hrdt', label: 'HRDT YAML' },
    { value: 'design-md', label: 'DESIGN.md' },
];

// Values match the core Format enum.
const outputFormats: Option[] = [
    { value: 'css', label: 'CSS' },
    { value: 'scss', label: 'SCSS' },
    { value: 'tailwind-v4', label: 'Tailwind v4' },
    { value: 'swiftui', label: 'SwiftUI' },
    { value: 'android', label: 'Android XML' },
    { value: 'figma-script', label: 'Figma script' },
    { value: 'dtcg', label: 'DTCG JSON' },
    { value: 'hrdt', label: 'HRDT YAML' },
    { value: 'design-md', label: 'DESIGN.md' },
];

---

<section
    class={styles.playground}
    aria-labelledby="playground-heading"
    data-playground
    data-playground-full={full ? 'true' : undefined}
>
    <div class={styles.sectionHeader}>
        <p class={styles.eyebrow}>Try it online</p>
        {full ? (
            <h1 id="playground-heading">Validate and convert tokens in your browser</h1>
        ) : (
            <h2 id="playground-heading">Validate and convert tokens in your browser</h2>
        )}
        {full ? (
            <p>
                Paste, drop, or upload DTCG JSON, HRDT YAML, or DESIGN.md. Tokens are checked and converted on your
                device and never leave the browser.
            </p>
        ) : (
            <p>
                Try the token workflow here, or open the full playground for file upload, validation, linting, and
                conversion. Everything runs locally in your browser.
            </p>
        )}
        {!full && (
            <a class={`${styles.primaryButton} ${styles.openButton}`} href="/playground/">
                Open full playground
            </a>
        )}
    </div>

    {full ? (
        <div class={styles.workspace}>
            <div class={styles.toolbar}>
                <div class={styles.toolbarGroup}>
                    <button class={styles.secondaryButton} type="button" data-playground-upload>Upload file</button>
                    <input
                        class={styles.visuallyHidden}
                        type="file"
                        accept=".json,.yaml,.yml,.md,application/json,text/yaml,text/markdown"
                        tabindex="-1"
                        aria-hidden="true"
                        data-playground-file-input
                    />
                    <label class={styles.field}>
                        <span class={styles.fieldLabel}>Example</span>
                        <span class={styles.selectWrap}>
                            <select class={styles.select} data-playground-example>
                                <option value="">Load example…</option>
                                {playgroundExamples.map((example) => (
                                    <option value={example.id}>{example.label}</option>
                                ))}
                            </select>
                            <span class={styles.selectChevron} aria-hidden="true"></span>
                        </span>
                    </label>
                    <label class={styles.field}>
                        <span class={styles.fieldLabel}>Input</span>
                        <span class={styles.selectWrap}>
                            <select class={styles.select} data-playground-input-format>
                                {inputFormats.map((format) => (
                                    <option value={format.value}>{format.label}</option>
                                ))}
                            </select>
                            <span class={styles.selectChevron} aria-hidden="true"></span>
                        </span>
                    </label>
                </div>
                <div class={styles.toolbarGroup}>
                    <label class={styles.checkbox}>
                        <input type="checkbox" data-playground-lint />
                        <span>Lint</span>
                    </label>
                    <button class={styles.secondaryButton} type="button" data-playground-validate>Revalidate</button>
                    <label class={styles.field}>
                        <span class={styles.fieldLabel}>Output</span>
                        <span class={styles.selectWrap}>
                            <select class={styles.select} data-playground-output-format>
                                {outputFormats.map((format) => (
                                    <option value={format.value} selected={format.value === 'css'}>{format.label}</option>
                                ))}
                            </select>
                            <span class={styles.selectChevron} aria-hidden="true"></span>
                        </span>
                    </label>
                    <button class={styles.primaryButton} type="button" data-playground-convert>Convert</button>
                    <button class={styles.secondaryButton} type="button" data-playground-download disabled>
                        Download
                    </button>
                </div>
            </div>
            <p class={styles.status} role="status" data-playground-status>
                Tokens are processed locally. Nothing is uploaded.
            </p>
            <div class={styles.panels}>
                <div class={styles.panel} data-playground-drop-zone="true">
                    <div class={styles.panelHeader}>
                        <label class={styles.panelTitle} for="playground-editor">Input</label>
                        <span class={styles.panelMeta} data-playground-source></span>
                    </div>
                    <textarea
                        id="playground-editor"
                        class={styles.editor}
                        spellcheck="false"
                        autocomplete="off"
                        autocapitalize="off"
                        placeholder="Paste tokens here or drop a file"
                        data-playground-editor
                    ></textarea>
                </div>
                <div class={styles.panel} data-playground-output-panel>
                    <div class={styles.panelHeader}>
                        <h3 class={styles.panelTitle}>Code</h3>
                        <span class={styles.selectWrap}>
                            <select class={styles.select} aria-label="Output file" hidden data-playground-output-file></select>
                            <span class={styles.selectChevron} aria-hidden="true"></span>
                        </span>
                    </div>
                    <div class={styles.view}>
                        <pre class={styles.code}><code data-playground-code></code></pre>
                        <p class={styles.placeholder} data-playground-code-placeholder>
                            Choose an output format and press Convert.
                        </p>
                    </div>
                </div>
                <aside
                    class={styles.issuesPanel}
                    aria-labelledby="playground-issues-heading"
                    data-playground-validation
                >
                    <div class={styles.panelHeader}>
                        <h3 id="playground-issues-heading" class={styles.panelTitle}>Issues</h3>
                    </div>
                    <p class={styles.summary} aria-live="polite" data-state="idle" data-playground-summary>
                        Not checked yet.
                    </p>
                    <ol class={styles.issueList} data-playground-issues></ol>
                </aside>
            </div>
        </div>
    ) : (
    <div class={styles.workspace}>
        <div class={styles.exampleBar}>
            <label class={styles.exampleField}>
                <span class={styles.fieldLabel}>Example</span>
                    <span class={styles.selectWrap}>
                        <select class={styles.select} data-playground-example>
                            <option value="">Load example…</option>
                            {playgroundExamples.map((example) => (
                                <option value={example.id}>{example.label}</option>
                            ))}
                        </select>
                        <span class={styles.selectChevron} aria-hidden="true"></span>
                    </span>
            </label>
        </div>

        <div class={styles.panels}>
            <div class={styles.panel} data-playground-drop-zone={full ? 'true' : undefined}>
                <div class={styles.panelHeader}>
                    <div class={styles.panelIdentity}>
                        <label class={styles.panelTitle} for="playground-editor">Input</label>
                        <span class={styles.panelMeta} data-playground-source></span>
                    </div>
                    <div class={styles.panelActions}>
                        {full && (
                            <>
                                <button class={styles.uploadButton} type="button" data-playground-upload>Upload file</button>
                                <input
                                    class={styles.visuallyHidden}
                                    type="file"
                                    accept=".json,.yaml,.yml,.md,application/json,text/yaml,text/markdown"
                                    tabindex="-1"
                                    aria-hidden="true"
                                    data-playground-file-input
                                />
                            </>
                        )}
                        <label class={styles.toggleField}>
                            <input type="checkbox" data-playground-lint />
                            <span class={styles.toggle} aria-hidden="true"></span>
                            <span>Lint</span>
                        </label>
                        <button class={styles.secondaryButton} type="button" data-playground-validate>Revalidate</button>
                    </div>
                </div>
                <div class={styles.editorFrame}>
                    <div class={styles.lineNumbers} aria-hidden="true" data-playground-input-lines>1</div>
                    <div class={styles.editorSurface}>
                        <pre class={styles.inputHighlight} aria-hidden="true" data-playground-input-highlight></pre>
                        <textarea
                            id="playground-editor"
                            class={styles.editor}
                            spellcheck="false"
                            autocomplete="off"
                            autocapitalize="off"
                            placeholder="Paste tokens here or drop a file"
                            data-playground-editor
                        ></textarea>
                    </div>
                </div>
            </div>

            <div class={styles.panel} data-playground-output-panel>
                <div class={styles.panelHeader}>
                    <h3 class={styles.panelTitle}>Code</h3>
                    <div class={styles.panelActions}>
                        <span class={styles.selectWrap}>
                            <select class={styles.select} aria-label="Output file" hidden data-playground-output-file></select>
                            <span class={styles.selectChevron} aria-hidden="true"></span>
                        </span>
                        <span class={styles.selectWrap}>
                            <select class={styles.select} aria-label="Output format" data-playground-output-format>
                                {outputFormats.map((format) => (
                                    <option value={format.value} selected={format.value === 'android'}>{format.label}</option>
                                ))}
                            </select>
                            <span class={styles.selectChevron} aria-hidden="true"></span>
                        </span>
                        <button class={styles.primaryButton} type="button" data-playground-convert>Convert</button>
                        {full && (
                            <button class={styles.downloadButton} type="button" data-playground-download disabled>
                                Download
                            </button>
                        )}
                    </div>
                </div>

                <div class={styles.view}>
                    <div class={`${styles.lineNumbers} ${styles.outputLineNumbers}`} aria-hidden="true" data-playground-output-lines></div>
                    <pre class={styles.code}><code data-playground-code></code></pre>
                    <p class={styles.placeholder} data-playground-code-placeholder>
                        Paste tokens or load an example to start.
                    </p>
                </div>
            </div>
        </div>

        <details class={styles.validationPanel} data-playground-validation>
            <summary class={styles.validationSummary}>
                <span class={styles.validationIcon} aria-hidden="true">✓</span>
                <span class={styles.validationCopy}>
                    <strong class={styles.summary} aria-live="polite" data-state="idle" data-playground-summary>
                        Validation pending
                    </strong>
                    <span class={styles.status} role="status" data-playground-status>
                        Your tokens are checked locally and never uploaded.
                    </span>
                </span>
                <span class={styles.validationChevron} aria-hidden="true">⌄</span>
            </summary>
            <div class={styles.validationDetails}>
                <ol class={styles.issueList} data-playground-issues></ol>
            </div>
        </details>

        {full && (
            <section class={styles.showcasePanel} aria-labelledby="showcase-heading">
                <div class={styles.panelHeader}>
                    <h2 id="showcase-heading" class={styles.panelTitle}>Showcase</h2>
                </div>
                <div class={styles.showcaseView}>
                    <iframe
                        class={styles.showcase}
                        title="Token showcase"
                        sandbox="allow-scripts"
                        hidden
                        data-playground-showcase
                    ></iframe>
                    <p class={styles.placeholder} data-playground-showcase-placeholder>
                        Convert tokens to render the showcase.
                    </p>
                </div>
            </section>
        )}
    </div>
    )}

    <template data-playground-issue-template>
        <li class={styles.issue}>
            <div class={styles.issueHeader}>
                <span class={styles.severity} data-issue-severity></span>
                <code class={styles.issueId} data-issue-id></code>
            </div>
            <p class={styles.issueMessage} data-issue-message></p>
            <p class={styles.issuePath} data-issue-path></p>
        </li>
    </template>
</section>

<script>
    import { initTokenPlayground } from '#/components/token-playground/playground';

    document.querySelectorAll<HTMLElement>('[data-playground]').forEach(initTokenPlayground);
</script>
